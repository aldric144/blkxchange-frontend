{
  "brandName": "BlkXchange™",
  "version": "19.6.2",
  "locked": true,
  "description": "Deep Luxury Color Scheme - DO NOT MODIFY without explicit approval",
  "colors": {
    "--color-bg-primary": "#001F3F",
    "--color-accent-gold": "#D4AF37",
    "--color-bg-dark": "#000000",
    "--color-text-light": "#FFFFFF",
    "--color-surface": "#0B0B0B",
    "--color-text-dark": "#1A1A1A",
    "--color-border-gold": "#D4AF37",
    "--color-hover-gold": "#E5C158"
  },
  "gradients": {
    "gold-metallic": "linear-gradient(90deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0) 20%)"
  },
  "typography": {
    "fontFamily": {
      "heading": "Inter, sans-serif",
      "body": "Inter, sans-serif"
    }
  },
  "spacing": {
    "navHeight": "4rem",
    "sectionPadding": "3rem"
  },
  "effects": {
    "goldGlow": "0 0 20px rgba(212, 175, 55, 0.25)",
    "goldGlowHover": "0 0 30px rgba(212, 175, 55, 0.4)",
    "cardShadow": "0 4px 6px rgba(0, 0, 0, 0.1)",
    "cardShadowHover": "0 10px 25px rgba(0, 0, 0, 0.2)"
  },
  "borders": {
    "gold": "1px solid var(--color-border-gold)",
    "goldThick": "2px solid var(--color-border-gold)"
  }
}
